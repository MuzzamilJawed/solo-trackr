<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps moving like the web splash (Capacitor overlay): the S orbits the ring and
  stays upright, the ring turns, the glow breathes. Starts in the static pose.
  GENERATED by scripts/gen-android-splash.py.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_web_icon">
  <target android:name="orbit">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="360" android:duration="3000" android:interpolator="@android:interpolator/linear" android:valueType="floatType" android:repeatCount="-1" />
    </aapt:attr>
  </target>
  <target android:name="badge">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="-360" android:duration="3000" android:interpolator="@android:interpolator/linear" android:valueType="floatType" android:repeatCount="-1" />
    </aapt:attr>
  </target>
  <target android:name="ring">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="360" android:duration="18000" android:interpolator="@android:interpolator/linear" android:valueType="floatType" android:repeatCount="-1" />
    </aapt:attr>
  </target>
  <target android:name="glowPath">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.45" android:valueTo="0.9" android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" />
    </aapt:attr>
  </target>
  <target android:name="glow">
    <aapt:attr name="android:animation">
      <set android:ordering="together">
        <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.18" android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" />
        <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.18" android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" />
      </set>
    </aapt:attr>
  </target>
</animated-vector>
