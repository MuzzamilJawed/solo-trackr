<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ launch screen: the web's pop-in + wordmark rise, then the S keeps
  orbiting (upright), the ring turns and the glow breathes until the app is ready.
  GENERATED by scripts/gen-android-splash.py.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_web_icon">
  <target android:name="stage">
    <aapt:attr name="android:animation">
      <set android:ordering="sequentially">
        <set android:ordering="together">
          <objectAnimator android:propertyName="scaleX" android:valueFrom="0.82" android:valueTo="1.04" android:duration="360" android:interpolator="@android:interpolator/decelerate_cubic" android:valueType="floatType" />
          <objectAnimator android:propertyName="scaleY" android:valueFrom="0.82" android:valueTo="1.04" android:duration="360" android:interpolator="@android:interpolator/decelerate_cubic" android:valueType="floatType" />
        </set>
        <set android:ordering="together">
          <objectAnimator android:propertyName="scaleX" android:valueFrom="1.04" android:valueTo="1" android:duration="240" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" />
          <objectAnimator android:propertyName="scaleY" android:valueFrom="1.04" android:valueTo="1" android:duration="240" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" />
        </set>
      </set>
    </aapt:attr>
  </target>
  <target android:name="word">
    <aapt:attr name="android:animation">
      <objectAnimator android:propertyName="translateY" android:valueFrom="7.5" android:valueTo="0" android:duration="700" android:interpolator="@android:interpolator/decelerate_cubic" android:valueType="floatType" android:startOffset="150" />
    </aapt:attr>
  </target>
  <target android:name="orbit">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="360" android:duration="3000" android:interpolator="@android:interpolator/linear" android:valueType="floatType" android:repeatCount="-1" />
    </aapt:attr>
  </target>
  <target android:name="badge">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="-360" android:duration="3000" android:interpolator="@android:interpolator/linear" android:valueType="floatType" android:repeatCount="-1" />
    </aapt:attr>
  </target>
  <target android:name="ring">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="360" android:duration="18000" android:interpolator="@android:interpolator/linear" android:valueType="floatType" android:repeatCount="-1" />
    </aapt:attr>
  </target>
  <target android:name="glowPath">
    <aapt:attr name="android:animation">
        <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.45" android:valueTo="0.9" android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" />
    </aapt:attr>
  </target>
  <target android:name="glow">
    <aapt:attr name="android:animation">
      <set android:ordering="together">
        <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.18" android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" />
        <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.18" android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" />
      </set>
    </aapt:attr>
  </target>
</animated-vector>
